{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "scripts/*.ts",
    "tests/**/*.test.ts",
    "tests/journeys/*.journey.ts",
    "functions/**/*.ts",
    "mailer/src/index.ts"
