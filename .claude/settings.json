{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": { "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "450000" },
  "permissions": {
    "allow": [
      "Bash(gh pr ready *)",
      "Bash(gh api -X POST repos/mcthaydt/AutomataFrameworkSite/pulls/*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/mcthaydt/AutomataFrameworkSite/pulls/*/ccr/ready_for_review)",
      "Bash(gh api -X POST repos/automata-framework/AutomataFrameworkSite/pulls/*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/automata-framework/AutomataFrameworkSite/pulls/*/ccr/ready_for_review)",
      "Bash(gh api -X POST repos/AutomataFramework/AutomataFrameworkSite/pulls/*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/AutomataFramework/AutomataFrameworkSite/pulls/*/ccr/ready_for_review)"
    ],
    "deny": [
      "Bash(gh api -X POST repos/mcthaydt/AutomataFrameworkSite/pulls/*/*/ccr/ready_for_review)",
      "Bash(gh api -X POST repos/mcthaydt/AutomataFrameworkSite/pulls/* */ccr/ready_for_review)",
      "Bash(gh api -X POST repos/mcthaydt/AutomataFrameworkSite/pulls/*?*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/mcthaydt/AutomataFrameworkSite/pulls/*/*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/mcthaydt/AutomataFrameworkSite/pulls/* */ccr/ready_for_review)",
      "Bash(gh api --method POST repos/mcthaydt/AutomataFrameworkSite/pulls/*?*/ccr/ready_for_review)",
      "Bash(gh api -X POST repos/automata-framework/AutomataFrameworkSite/pulls/*/*/ccr/ready_for_review)",
      "Bash(gh api -X POST repos/automata-framework/AutomataFrameworkSite/pulls/* */ccr/ready_for_review)",
      "Bash(gh api -X POST repos/automata-framework/AutomataFrameworkSite/pulls/*?*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/automata-framework/AutomataFrameworkSite/pulls/*/*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/automata-framework/AutomataFrameworkSite/pulls/* */ccr/ready_for_review)",
      "Bash(gh api --method POST repos/automata-framework/AutomataFrameworkSite/pulls/*?*/ccr/ready_for_review)",
      "Bash(gh api -X POST repos/AutomataFramework/AutomataFrameworkSite/pulls/*/*/ccr/ready_for_review)",
      "Bash(gh api -X POST repos/AutomataFramework/AutomataFrameworkSite/pulls/* */ccr/ready_for_review)",
      "Bash(gh api -X POST repos/AutomataFramework/AutomataFrameworkSite/pulls/*?*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/AutomataFramework/AutomataFrameworkSite/pulls/*/*/ccr/ready_for_review)",
      "Bash(gh api --method POST repos/AutomataFramework/AutomataFrameworkSite/pulls/* */ccr/ready_for_review)",
      "Bash(gh api --method POST repos/AutomataFramework/AutomataFrameworkSite/pulls/*?*/ccr/ready_for_review)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/after-compaction.md\"" }]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Agent|Workflow|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
